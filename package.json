{
  "name": "agent-forge",
  "version": "0.1.0",
  "description": "Local AI Engineering Orchestrator / Owner Control Center",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.node.json && node -e \"fs.writeFileSync('dist-electron/package.json', JSON.stringify({type: 'commonjs'}, null, 2))\"",
    "package:win:dir": "npm run build && npx @electron/rebuild -f -w better-sqlite3 && electron-builder --win --dir --publish never",
    "package:win": "npm run build && npx @electron/rebuild -f -w better-sqlite3 && electron-builder --win nsis --publish never",
    "smoke:packaged:win": "powershell -ExecutionPolicy Bypass -File scripts/smoke-packaged-win.ps1",
    "smoke:dev:electron": "powershell -ExecutionPolicy Bypass -File scripts/smoke-dev-electron.ps1",
    "test:installed:win": "powershell -ExecutionPolicy Bypass -File scripts/test-installed-update-win.ps1",
    "test": "node scripts/run-test-suite.cjs",
    "test:watch": "vitest",
    "mcp:stdio": "node dist-electron/mcp/stdio.js",
    "mcp:session-admin": "node dist-electron/mcp/sessionAdmin.js",
    "mcp:submission-stdio": "node dist-electron/mcp/stdio-submit.js",
    "mcp:submission-admin": "node dist-electron/mcp/submissionAdmin.js",
    "mcp:reviewer-stdio": "node dist-electron/mcp/stdio-review.js",
    "mcp:reviewer-admin": "node dist-electron/mcp/reviewerAdmin.js",
    "autonomy:doctor": "node dist-electron/electron/autonomyCli.js doctor",
    "autonomy:doctor:omniroute": "node dist-electron/electron/autonomyCli.js doctor-omniroute",
    "autonomy:doctor:omniroute-coder": "node dist-electron/electron/autonomyCli.js doctor-omniroute-coder",
    "autonomy:shadow": "node dist-electron/electron/autonomyCli.js shadow",
    "autonomy:pilot": "node dist-electron/electron/autonomyCli.js pilot",
    "autonomy:start": "node dist-electron/electron/autonomyCli.js start",
    "autonomy:status": "node dist-electron/electron/autonomyCli.js status",
    "autonomy:stop": "node dist-electron/electron/autonomyCli.js stop",
    "autonomy:recover": "node dist-electron/electron/autonomyCli.js recover",
    "autonomy:observe": "node dist-electron/electron/autonomyCli.js observe",
    "autonomy:register-ci": "node dist-electron/electron/autonomyCli.js register-ci",
    "autonomy:trial-manifest": "node dist-electron/electron/autonomyCli.js trial-manifest",
    "autonomy:verify-trial-manifest": "node dist-electron/electron/autonomyCli.js verify-trial-manifest",
    "autonomy:trial-readiness": "node dist-electron/electron/autonomyCli.js trial-readiness",
    "autonomy:trial-run-register": "node dist-electron/electron/autonomyCli.js trial-run-register",
    "autonomy:trial-run-start": "node dist-electron/electron/autonomyCli.js trial-run-start",
    "autonomy:trial-run-complete": "node dist-electron/electron/autonomyCli.js trial-run-complete",
    "autonomy:trial-run-list": "node dist-electron/electron/autonomyCli.js trial-run-list",
    "autonomy:trial-log-collect": "node dist-electron/electron/autonomyCli.js trial-log-collect",
    "autonomy:trial-log-verify": "node dist-electron/electron/autonomyCli.js trial-log-verify",
    "autonomy:register-review-wait": "node dist-electron/electron/autonomyCli.js register-review-wait",
    "autonomy:review-waits": "node dist-electron/electron/autonomyCli.js review-waits",
    "autonomy:observe-review-capacity": "node dist-electron/electron/autonomyCli.js observe-review-capacity"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@modelcontextprotocol/client": "2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
